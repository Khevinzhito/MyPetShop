    <string name="pet_tip_transition_title">Transición a Advance</string>
    <string name="pet_tip_transition_body">Vienes de %1$s. Para tu %2$s te recomendamos migrar a Advance de Logus en 7–10 días mezclando un 25%% más cada 2 días hasta completar el cambio.</string>
    <string name="pet_tip_transition_steps_title">Pasos de la transición</string>
    <string name="pet_tip_transition_steps_body">Días 1–2: 75%% comida actual + 25%% Advance. Días 3–4: 50/50. Días 5–6: 25%% actual + 75%% Advance. Día 7+: 100%% Advance. Mantén horarios fijos y agua fresca.</string>
    <string name="pet_tip_daily_title">Tip del día</string>
    <string name="pet_tip_daily_dog_body">Tu %1$s de %2$d años necesita rutina de paseo y agua limpia. Revisa su peso cada mes para ajustar la ración.</string>
    <string name="pet_tip_daily_cat_body">Tu %1$s de %2$d años prefiere comederos separados del agua. Juegos cortos diarios mejoran su bienestar.</string>
    <string name="pet_tip_sterilized_title">Mascota esterilizada</string>
    <string name="pet_tip_sterilized_dog_body">Advance Light o fórmulas Light controlan calorías y mantienen masa muscular en perros esterilizados.</string>
    <string name="pet_tip_sterilized_cat_body">Advance Gato Esterilizado equilibra peso y salud urinaria, ideal para tu felino.</string>
